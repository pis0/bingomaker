{
  "name": "bingomaker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:sim": "vitest run src/engine/__tests__/simulation.test.ts --reporter=verbose",
    "test:sim:watch": "vitest src/engine/__tests__/simulation.test.ts --reporter=verbose",
    "deploy": "npm run build && aws s3 sync dist s3://virtuware.io/bingomaker/ --delete --profile vw-admin && aws s3 cp s3://virtuware.io/bingomaker/index.html s3://virtuware.io/bingomaker/index.html --cache-control 'no-cache, no-store, must-revalidate' --content-type 'text/html' --metadata-directive REPLACE --profile vw-admin && aws cloudfront create-invalidation --distribution-id E22CDK3ML9CMUJ --paths '/bingomaker/*' --profile vw-admin"
  },
  "dependencies": {
    "@pixi/react": "^8.0.5",
    "pixi.js": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "sharp": "^0.34.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
